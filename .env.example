# ==============================================================================
# RoundTrip Frontend — Environment Variables Template
# ==============================================================================
# 1. 이 파일을 `.env` 로 복사한 뒤 실제 값으로 채운다.
# 3. `EXPO_PUBLIC_*` 접두 변수는 클라이언트 번들에 인라인된다 → "공개되어도 안전한 키" 만 둔다.
# 4. 접두 없는 변수는 `app.config.ts` 빌드 시점에서만 사용 (런타임 노출 X).
# 5. EAS 빌드는 `eas.json` profile env + EAS Secrets 에서 주입한다.
# ==============================================================================

# ---- Runtime mode -------------------------------------------------------------
# 사용하려는 모드 한 줄만 복사해서 사용한다. 목록에 없는 값은 development로 처리된다.
# development: Axios mock ON, 좌측 상단 화면 이름 표시 ON
# preview:     Axios mock ON, 좌측 상단 화면 이름 표시 OFF
# production:  Axios mock OFF, 좌측 상단 화면 이름 표시 OFF
# iOS bundle id / Android package는 APP_ENV와 무관하게 com.roundtriptime.roundtrip 하나로 고정한다.
# APP_ENV=development
# APP_ENV=preview
# APP_ENV=production
APP_ENV=production

# ---- Backend API --------------------------------------------------------------
# Swagger UI: https://roundtrip.duckdns.org/swagger-ui/index.html
# OpenAPI servers.url 기준으로 /v1 prefix 없이 호출한다.
EXPO_PUBLIC_API_BASE_URL=https://roundtrip.duckdns.org

# ---- Auth debug ---------------------------------------------------------------
# 값이 있으면 앱 부팅 시 POST /auth/test-token 으로 테스트 세션을 발급받는다.
# 테스트용 secret도 EXPO_PUBLIC_* 이면 클라이언트 번들에 포함되므로 로컬 디버깅에서만 사용한다.
EXPO_PUBLIC_AUTH_TEST_SECRET=
# true면 앱 부팅 시 SecureStore access/refresh token을 먼저 삭제한다. 로컬 디버깅용.
EXPO_PUBLIC_CLEAR_STORED_TOKENS_ON_BOOT=false

# ---- OAuth / Social Login (WF-08) --------------------------------------------
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# ---- Maps (WF-11 / WF-13) ----------------------------------------------------
# 클라이언트 SDK 용 키. iOS/Android 앱 번들 ID 로 제한된 키 사용 권장.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_KAKAO_JS_KEY=

# ---- Error tracking (WF-02) --------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=

# ---- AdMob (WF-14) — build-time only, 런타임 미노출 ----------------------------
# react-native-google-mobile-ads 가 app.config.ts plugin 인자로 사용.
GOOGLE_ADMOB_ANDROID_APP_ID=
GOOGLE_ADMOB_IOS_APP_ID=
