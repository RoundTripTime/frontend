root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown — keep trailing whitespace for hard line breaks
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# Native iOS project files use tabs
[*.{pbxproj,xcconfig,xcscheme}]
indent_style = tab

# Native Android Gradle scripts
[*.gradle]
indent_size = 4
